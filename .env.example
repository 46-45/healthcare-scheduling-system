# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare

# Auth Service Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare?schema=auth_schema
JWT_SECRET=*****
JWT_EXPIRATION=3600

# Schedule Service Configuration
SCHEDULE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare?schema=schedule_schema
AUTH_SERVICE_URL=http://localhost:3001

# Service Ports
AUTH_SERVICE_PORT=3001
SCHEDULE_SERVICE_PORT=3002

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Email Configuration
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@healthcare-scheduling.com
SMTP_FROM_NAME=Healthcare Scheduling System

# Mailpit Web UI
MAILPIT_WEB_PORT=8025
