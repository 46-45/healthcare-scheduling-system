  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.register) {",
                  "    pm.test(\"User registered successfully\", function () {",
                  "        pm.expect(jsonData.data.register).to.have.property('id');",
                  "        pm.expect(jsonData.data.register).to.have.property('email');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($email: String!, $password: String!) {\n  register(email: $email, password: $password) {\n    id\n    email\n    createdAt\n    updatedAt\n  }\n}",
                "variables": "{\n  \"email\": \"daniel@hospital.com\",\n  \"password\": \"Daniel_123\"\n}"
              }
            },
            "url": {
              "raw": "{{auth_url}}",
              "host": ["{{auth_url}}"]
            }
          },
          "response": []
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.login) {",
                  "    pm.test(\"Login successful\", function () {",
                  "        pm.expect(jsonData.data.login).to.have.property('accessToken');",
                  "        pm.expect(jsonData.data.login).to.have.property('expiresAt');",
                  "    });",
                  "    ",
                  "    // Save token to collection variable",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.data.login.accessToken);",
                  "    console.log(\"Access token saved:\", jsonData.data.login.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($email: String!, $password: String!) {\n  login(email: $email, password: $password) {\n    accessToken\n    expiresAt\n  }\n}",
                "variables": "{\n  \"email\": \"daniel@hospital.com\",\n  \"password\": \"Daniel_123\"\n}"
              }
            },
            "url": {
              "raw": "{{auth_url}}",
              "host": ["{{auth_url}}"]
            }
          },
          "response": []
        },
        {
          "name": "3. Validate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query ValidateToken($token: String!) {\n  validateToken(token: $token) {\n    id\n    email\n    createdAt\n    updatedAt\n  }\n}",
                "variables": "{\n  \"token\": \"{{access_token}}\"\n}"
              }
            },
            "url": {
              "raw": "{{auth_url}}",
              "host": ["{{auth_url}}"]
            }
          },
          "response": []
        }
      ]
